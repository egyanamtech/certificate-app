# ==== Certificate DApp Configuration ====
# Copy this file to .env and fill in your values:  cp .env.example .env

# Admin wallet private key (used by backend to sign blockchain transactions)
# WARNING: Never share this key or commit the real .env to git.
ADMIN_PRIVATE_KEY=your_admin_wallet_private_key

# Admin portal login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Sepolia testnet RPC endpoint
SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com

# Deployed Certificate contract address (addCertificate(string,string,string))
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Optional overrides
# PORT=5000
# HOST=0.0.0.0

# PostgreSQL database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=certificate_app

PINATA_JWT=your-pinata-jwt
